# TypeWriter Environment Variables
# Copy this file to .env and fill in your values

# Web editor auth token (server API auth).
# When set, every /api/* request and websocket upgrade must present it
# as an Authorization: Bearer header (or ?token= query param).
# When unset, local-only use is allowed but /api/exec and agent installs
# stay DISABLED for safety.
# TYPEWRITER_TOKEN=your_secret_token_here

# GitHub access is NOT configured here. Connect from the web Account panel
# (device flow or personal access token) or via the CLI:
#   node dist/index.js --login
# The GitHub token is stored in ~/.typewriter/token (mode 0600) and never
# leaves the server — the browser only talks to /api/github/*.
