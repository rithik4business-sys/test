{
  "name": "typewriter-editor",
  "version": "1.3.0",
  "description": "A GitHub-connected terminal code editor",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "public/",
    "assets/",
    "README.md",
    "LICENSE",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "npx tsc && node -e \"try{require('fs').cpSync('assets','dist/assets',{recursive:true,force:true})}catch(e){console.error('asset copy failed:',e.message);process.exit(1)}\"",
    "start": "node dist/index.js",
    "dev": "npx tsc && node dist/index.js",
    "serve": "npm run build && node dist/server.js",
    "preview": "npm run build && node dist/server.js",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "test:ts": "npx tsc -p tsconfig.test.json && node --test \"dist-test/test-ts/*.test.js\"",
    "bench": "npm run build && node scripts/bench.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "bin": {
    "typewriter": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "editor",
    "terminal",
    "github",
    "code"
  ],
  "license": "MIT",
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
